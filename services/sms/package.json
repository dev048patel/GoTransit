{
  "name": "transitr-sms",
  "version": "0.1.0",
  "private": true,
  "description": "SMS commute alerts for Transit Regina, deployed as its own service",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:timetable": "node scripts/build-timetable.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "tsx": "^4.21.0",
    "twilio": "^6.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
